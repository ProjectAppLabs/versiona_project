# =============================================================================
# E2E harness environment — copy to .env.e2e (gitignored) and edit
# =============================================================================
# Every backend process the Playwright suite starts reads these INSTEAD of the
# matching keys in .env: the seed command, the token minter and the Django
# server the browser talks to.
#
# Why this file exists: on a deployment host the work clone IS the deployment,
# so .env names the LIVE database. Without this file, `npx playwright test`
# would seed test accounts (owner@versiona.test / secreta123) straight into it.
# The seed command refuses that on its own (core.fake_data_guard) — this file is
# how you give the suite somewhere safe to write instead.
#
# CI does not use this file: its job environment already names a disposable
# database, and DJANGO_ENV is unset there (so it defaults to development).
#
#   cp backend/.env.e2e.example backend/.env.e2e

# Must NOT be 'production', or the fake-data guard refuses (correctly).
DJANGO_ENV=development

# A THROWAWAY database. Never the one .env names on a deployment host — this
# suite trashes projects, revokes seals and reseeds on every run.
DJANGO_DB_NAME=versiona_e2e
DB_USER=versiona_project_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# A Redis db of its own, so a stray task cannot land on the deployment's queue.
REDIS_URL=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=1

# Non-quota browser flows share one runner IP; backend quota tests use 5/min.
THROTTLE_AUTH=1000/min

# Leave EMPTY. With a sendfile root set, delivery is handed to nginx via
# X-Accel-Redirect and Django answers 200 with an empty body — every test that
# downloads a file then fails against a server Playwright started itself.
OBJECT_STORAGE_SENDFILE_ROOT=
